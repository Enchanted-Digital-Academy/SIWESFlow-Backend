enum SupervisorActivationStatus {
  INVITED
  PROFILE_COMPLETED
  ACTIVE
  SUSPENDED
}

model Supervisor {
  id String @id @default(cuid())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fullName        String
  position        String
  department      String
  email           String  @unique
  phone           String
  profileImageUrl String?

  companyStaffId String?

  activationStatus SupervisorActivationStatus @default(INVITED)
  confirmedById    String?
  confirmedBy      User?                       @relation("SupervisorConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt      DateTime?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedBy         User?               @relation("SupervisorVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?

  students           Student[]
  documents          Document[]
  reviewedActivities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([activationStatus])
}