// A document belongs to exactly one owner. This is enforced in Postgres by the
// "document_single_owner" CHECK constraint (migration 20261019090100) and
// validated again in document.service.ts before insert.

enum DocumentType {
  PASSPORT_PHOTO
  STUDENT_ID_CARD
  ACCEPTANCE_LETTER
  PLACEMENT_LETTER
  SCHOOL_INTRO_LETTER
  ACCREDITATION_DOCUMENT
  SIWES_GUIDELINES
  CAC_REGISTRATION
  BUSINESS_REGISTRATION
  GOVERNMENT_ID
  PROOF_OF_EMPLOYMENT
  ACTIVITY_EVIDENCE
  COMPLETION_LETTER
  COMPLETION_CERTIFICATE
  OTHER
}

enum FileFormat {
  PDF
  DOC
  DOCX
  JPG
  JPEG
  PNG
}

model Document {
  id String @id @default(cuid())

  studentId    String?
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId     String?
  school       School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supervisorId String?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  documentType  DocumentType
  filename      String
  fileFormat    FileFormat
  fileSizeBytes Int
  storageKey    String

  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedBy         User?               @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?

  verification   Verification? @relation(fields: [verificationId], references: [id])
  verificationId String?

  activities Activity[]

  @@index([studentId])
  @@index([schoolId])
  @@index([companyId])
  @@index([supervisorId])
  @@index([documentType])
  @@index([verificationStatus])
}