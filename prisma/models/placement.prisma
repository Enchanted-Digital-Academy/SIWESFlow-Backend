model Placement {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  department     String
  requiredLevel  String?
  requiredSkills String[]

  availableSlots Int
  filledSlots    Int @default(0)

  startDate DateTime
  endDate   DateTime
  location  String?
  workMode  WorkMode @default(ON_SITE)

  isActive Boolean @default(true)

  // School approval of the placement. New placements start PENDING.
  approvalStatus PlacementApprovalStatus @default(PENDING)
  approvedById   String?
  approvedBy     User?                   @relation("PlacementApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  approvalNote   String?

  applications Application[]
  students     Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([isActive])
  @@index([approvalStatus])
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum PlacementApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
