enum InstitutionType {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE
  OTHER
}

model School {
  id String @id @default(cuid())

  schoolCode      String @unique
  name            String
  institutionType InstitutionType

  address String
  state   String
  country String

  email   String  @unique
  phone   String
  website String?
  logoUrl String?

  coordinatorId    String?
  coordinator      User?   @relation("SchoolCoordinator", fields: [coordinatorId], references: [id])
  coordinatorEmail String?
  coordinatorPhone String?

  faculties         String[]
  departments       String[]
  programmes        String[]
  levels            String[]
  siwesRequirements String?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedBy         User?               @relation("SchoolVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?

  students          Student[]
  approvedCompanies Company[] @relation("SchoolApprovedCompanies")
  documents         Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}